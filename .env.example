# === API Gateway Configuration ===
PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# === Downstream Services Configuration ===
# Core (PostgreSQL Domain & Auth)
CORE_SERVICE_URL=http://localhost:3000
CORE_GRAPHQL_URL=http://localhost:3000/graphql

# Spring Boot (Documental / PDF Generation)
SPRING_BOOT_SERVICE_URL=http://localhost:8082

# Backend IA (FastAPI / Machine Learning / Deep Learning)
AI_SERVICE_URL=http://localhost:8001
AI_API_KEY=replace-with-a-secret-shared-only-with-fastapi

# Shared only by gateway and protected internal services
INTERNAL_SERVICE_KEY=replace-with-a-secret-shared-only-with-downstream-services

# Downstream timeout policies
CORE_TIMEOUT_MS=5000
AI_TIMEOUT_MS=60000
DOCUMENTS_TIMEOUT_MS=30000
PAYMENTS_TIMEOUT_MS=10000

# Payments Service (Subscriptions & Invoicing)
PAYMENTS_SERVICE_URL=
